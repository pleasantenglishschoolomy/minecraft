const CLOUD_PLANE = 900;
function makeCloudMat(brightness){
  return new THREE.ShaderMaterial({
    transparent:true, depthWrite:false, side:THREE.DoubleSide, fog:false,
    uniforms:{
      map:{value:cloudTex}, tint:{value:new THREE.Color(1,1,1)}, bright:{value:brightness},
      uvScale:{value:new THREE.Vector2(1,1)}, uvOffset:{value:new THREE.Vector2(0,0)}
    },
    vertexShader: 'uniform vec2 uvScale; uniform vec2 uvOffset; varying vec2 vUv; varying vec3 vW; void main(){ vUv = uv*uvScale + uvOffset; vec4 w = modelMatrix*vec4(position,1.0); vW = w.xyz; gl_Position = projectionMatrix*viewMatrix*w; }',
    fragmentShader: 'uniform sampler2D map; uniform vec3 tint; uniform float bright; varying vec2 vUv; varying vec3 vW; void main(){ float a = texture2D(map, vUv).a; float d = length(vW.xz - cameraPosition.xz); float fade = 1.0 - smoothstep(140.0, 400.0, d); gl_FragColor = vec4(tint*bright, a*fade*0.92); if(gl_FragColor.a < 0.02) discard; }'
  });
}
const cloudTop = new THREE.Mesh(new THREE.PlaneGeometry(CLOUD_PLANE, CLOUD_PLANE), makeCloudMat(1.0));
const cloudBottom = new THREE.Mesh(new THREE.PlaneGeometry(CLOUD_PLANE, CLOUD_PLANE), makeCloudMat(0.72));
cloudTop.rotation.x = cloudBottom.rotation.x = -Math.PI/2;
cloudTop.renderOrder = 1; cloudBottom.renderOrder = 0;
cloudTop.frustumCulled = cloudBottom.frustumCulled = false;
scene.add(cloudTop); scene.add(cloudBottom);
let cloudDrift = 0;
 
function updateClouds(dt){
  cloudDrift += dt*2.2;
  const period = CLOUD_TEX_SIZE*CLOUD_CELL_UNITS;
  const rep = CLOUD_PLANE/period;
  const ox = (camera.position.x + cloudDrift)/period - 0.5*rep;
  const oy = -camera.position.z/period - 0.5*rep;
  for(const m of [cloudTop, cloudBottom]){
    m.material.uniforms.uvScale.value.set(rep, rep);
    m.material.uniforms.uvOffset.value.set(ox, oy);
    m.position.x = camera.position.x; m.position.z = camera.position.z;
    m.material.uniforms.tint.value.copy(lightColor);
  }
  cloudTop.position.y = WORLD_HEIGHT + 30;
  cloudBottom.position.y = WORLD_HEIGHT + 28.5;
}
 
