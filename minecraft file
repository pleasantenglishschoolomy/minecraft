/* ============================ HAND (first-person held block) ============================ */
function makeBlockGeometry(block, size){
  const B = newBuf();
  const t = BLOCK_TILES[block];
  for(let f=0; f<6; f++){
    const face = FACES[f];
    const tile = f===2 ? t[0] : (f===3 ? t[1] : t[2]);
    const uv = tileUV(tile);
    const pts = face.corners.map(c => [(c[0]-0.5)*size, (c[1]-0.5)*size, (c[2]-0.5)*size]);
    const uvs = FACE_UVC[f].map(cu => [cu[0]?uv[2]:uv[0], cu[1]?uv[3]:uv[1]]);
    const s = FACE_SHADE[f];
    pushQuad(B, pts, uvs, [s,s,s,s], false);
  }
  return bufToGeo(B);
}
const handMesh = new THREE.Mesh(makeBlockGeometry(inventory[0].block, 0.4), handMat);
handScene.add(handMesh);
let swingT = 1, bobT = 0;
function refreshHand(){
  handMesh.geometry.dispose();
  handMesh.geometry = makeBlockGeometry(inventory[selectedSlot].block, 0.4);
}
function updateHand(dt, moving){
  if(swingT < 1) swingT = Math.min(1, swingT + dt*4.2);
  if(moving) bobT += dt*10;
  const s = Math.sin(swingT*Math.PI);
  const bx = moving ? Math.sin(bobT)*0.012 : 0, by = moving ? Math.abs(Math.cos(bobT))*0.02 : 0;
  handMesh.position.set(0.58 - s*0.28 + bx, -0.52 - s*0.1 + by, -1.0 - s*0.25);
  handMesh.rotation.set(0.28 - s*0.9, 0.75 - s*0.3, 0.04);
}
 
/* ============================ PARTICLES ============================ */
const particles = [];
const particleGeo = new THREE.BoxGeometry(0.11,0.11,0.11);
function spawnParticles(x,y,z,block){
  const t = BLOCK_TILES[block] ? BLOCK_TILES[block][2] : PLANT_TILE[block];
  const base = TILE_COLORS[t] || new THREE.Color(0.5,0.5,0.5);
  for(let i=0;i<14;i++){
    const m = new THREE.MeshBasicMaterial({ color:base.clone().multiplyScalar(0.7+Math.random()*0.5) });
    const mesh = new THREE.Mesh(particleGeo, m);
    mesh.position.set(x+0.15+Math.random()*0.7, y+0.15+Math.random()*0.7, z+0.15+Math.random()*0.7);
    scene.add(mesh);
    particles.push({ mesh, base:m.color.clone(), vel:new THREE.Vector3((Math.random()-0.5)*3.2, Math.random()*3.5+0.5, (Math.random()-0.5)*3.2), life:0.55+Math.random()*0.5, max:1 });
    particles[particles.length-1].max = particles[particles.length-1].life;
  }
}
function updateParticles(dt){
  for(let i=particles.length-1;i>=0;i--){
    const p = particles[i];
    p.life -= dt;
    if(p.life <= 0){ scene.remove(p.mesh); p.mesh.material.dispose(); particles.splice(i,1); continue; }
    p.vel.y -= 16*dt;
    p.mesh.position.addScaledVector(p.vel, dt);
    p.mesh.rotation.x += dt*6; p.mesh.rotation.y += dt*5;
    p.mesh.scale.setScalar(Math.max(0.2, p.life/p.max));
    p.mesh.material.color.copy(p.base).multiply(lightColor);
  }
}
 
