// clouds
const CLOUD_TEX_SIZE = 256, CLOUD_CELL_UNITS = 8; // world units per texel
(function(){})();
const cloudCanvas = document.createElement('canvas');
cloudCanvas.width = cloudCanvas.height = CLOUD_TEX_SIZE;
(function(){
  const g = cloudCanvas.getContext('2d');
  const img = g.createImageData(CLOUD_TEX_SIZE, CLOUD_TEX_SIZE);
  const r = rng32(2024);
  const octs = [];
  const sizes = [8, 16, 32];
  sizes.forEach(n => { const a=[]; for(let i=0;i<n*n;i++) a.push(r()); octs.push({n,a}); });
  function sample(o, x, y){
    const fx = x/CLOUD_TEX_SIZE*o.n, fy = y/CLOUD_TEX_SIZE*o.n;
    const xi = Math.floor(fx), yi = Math.floor(fy);
    const xf = fx-xi, yf = fy-yi;
    const u = xf*xf*(3-2*xf), v = yf*yf*(3-2*yf);
    const w = i => ((i%o.n)+o.n)%o.n;
    const a = o.a[w(yi)*o.n+w(xi)], b = o.a[w(yi)*o.n+w(xi+1)], c = o.a[w(yi+1)*o.n+w(xi)], d = o.a[w(yi+1)*o.n+w(xi+1)];
    return a + (b-a)*u + (c-a)*v + (a-b-c+d)*u*v;
  }
  for(let y=0;y<CLOUD_TEX_SIZE;y++) for(let x=0;x<CLOUD_TEX_SIZE;x++){
    const v = sample(octs[0],x,y)*0.55 + sample(octs[1],x,y)*0.3 + sample(octs[2],x,y)*0.15;
    const o = (y*CLOUD_TEX_SIZE+x)*4;
    const on = v > 0.54;
    img.data[o]=255; img.data[o+1]=255; img.data[o+2]=255; img.data[o+3]= on ? 255 : 0;
  }
  g.putImageData(img,0,0);
})();
const cloudTex = new THREE.CanvasTexture(cloudCanvas);
cloudTex.wrapS = cloudTex.wrapT = THREE.RepeatWrapping;
cloudTex.magFilter = cloudTex.minFilter = THREE.NearestFilter;
