  document.getElementById('menu').style.display = 'none';
  menuHidden = true;
  canvas.requestPointerLock();
});
document.getElementById('respawnBtn').addEventListener('click', () => {
  player.health = player.maxHealth; player.hunger = player.maxHunger; player.alive = true;
  findSpawn(); player.vel.set(0,0,0);
  document.getElementById('deathScreen').style.display = 'none';
  canvas.requestPointerLock();
});
 
/* ============================ RAYCAST (voxel DDA) ============================ */
function raycastVoxel(origin, dir, maxDist){
  let x = Math.floor(origin.x), y = Math.floor(origin.y), z = Math.floor(origin.z);
  const stepX = dir.x>0?1:-1, stepY = dir.y>0?1:-1, stepZ = dir.z>0?1:-1;
  const tDeltaX = dir.x!==0 ? Math.abs(1/dir.x) : Infinity;
  const tDeltaY = dir.y!==0 ? Math.abs(1/dir.y) : Infinity;
  const tDeltaZ = dir.z!==0 ? Math.abs(1/dir.z) : Infinity;
  function frac(v, step){ return step>0 ? (1-(v-Math.floor(v))) : (v-Math.floor(v)); }
  let tMaxX = tDeltaX * frac(origin.x, stepX);
  let tMaxY = tDeltaY * frac(origin.y, stepY);
  let tMaxZ = tDeltaZ * frac(origin.z, stepZ);
  let dist = 0, lastNormal = [0,0,0];
  for(let i=0;i<64;i++){
    const b = getBlock(x,y,z);
    if(b !== BLOCK.AIR && b !== BLOCK.WATER) return { x,y,z, block:b, normal:lastNormal };
    if(tMaxX < tMaxY && tMaxX < tMaxZ){ x += stepX; dist = tMaxX; tMaxX += tDeltaX; lastNormal=[-stepX,0,0]; }
    else if(tMaxY < tMaxZ){ y += stepY; dist = tMaxY; tMaxY += tDeltaY; lastNormal=[0,-stepY,0]; }
    else { z += stepZ; dist = tMaxZ; tMaxZ += tDeltaZ; lastNormal=[0,0,-stepZ]; }
    if(dist > maxDist) return null;
  }
  return null;
}
function getLookDir(){
  const dir = new THREE.Vector3(0,0,-1);
  dir.applyEuler(new THREE.Euler(player.pitch, player.yaw, 0, 'YXZ'));
  return dir;
}
function eyePos(){ return new THREE.Vector3(player.pos.x, player.pos.y+PLAYER_HEIGHT*0.9, player.pos.z); }
 
function breakBlock(){
  const hit = raycastVoxel(eyePos(), getLookDir(), 6);
  swingT = 0;
  if(hit && hit.block !== BLOCK.BEDROCK){
    setBlock(hit.x, hit.y, hit.z, BLOCK.AIR);
    if(isPlant(getBlock(hit.x, hit.y+1, hit.z))) setBlock(hit.x, hit.y+1, hit.z, BLOCK.AIR);
    spawnParticles(hit.x, hit.y, hit.z, hit.block);
    addToInventory(hit.block);
    rebuildAround(hit.x, hit.z);
  }
}
function placeBlock(){
  const hit = raycastVoxel(eyePos(), getLookDir(), 6);
  if(hit){
    const px = hit.x + hit.normal[0], py = hit.y + hit.normal[1], pz = hit.z + hit.normal[2];
    const pmin = { x:player.pos.x-PLAYER_RADIUS, y:player.pos.y, z:player.pos.z-PLAYER_RADIUS };
    const pmax = { x:player.pos.x+PLAYER_RADIUS, y:player.pos.y+PLAYER_HEIGHT, z:player.pos.z+PLAYER_RADIUS };
    if(px+1>pmin.x && px<pmax.x && pz+1>pmin.z && pz<pmax.z && py+1>pmin.y && py<pmax.y) return;
    const slot = inventory[selectedSlot];
    if(slot.count > 0){
      setBlock(px,py,pz, slot.block);
      slot.count--;
      updateHotbarUI();
      rebuildAround(px,pz);
    }
  }
}
function addToInventory(blockType){
  if(blockType === BLOCK.WATER || blockType === BLOCK.BEDROCK || isPlant(blockType)) return;
  for(const slot of inventory){
    if(slot.block === blockType){ slot.count++; updateHotbarUI(); return; }
  }
  // stone replaces cobble-less drops etc.; blocks without a slot are ignored
}
 
/* ============================ PHYSICS / COLLISION ============================ */
function collides(pos){
  const minX = Math.floor(pos.x - PLAYER_RADIUS), maxX = Math.floor(pos.x + PLAYER_RADIUS);
  const minY = Math.floor(pos.y), maxY = Math.floor(pos.y + PLAYER_HEIGHT);
  const minZ = Math.floor(pos.z - PLAYER_RADIUS), maxZ = Math.floor(pos.z + PLAYER_RADIUS);
  for(let x=minX;x<=maxX;x++) for(let y=minY;y<=maxY;y++) for(let z=minZ;z<=maxZ;z++){
    if(isSolid(getBlock(x,y,z))) return true;
  }
  return false;
}
 
let moving = false;
function updatePhysics(dt){
  const fwd = new THREE.Vector3(-Math.sin(player.yaw), 0, -Math.cos(player.yaw));
  const right = new THREE.Vector3(Math.cos(player.yaw), 0, -Math.sin(player.yaw));
  let moveX = 0, moveZ = 0;
  if(keys['KeyW']) { moveX += fwd.x; moveZ += fwd.z; }
  if(keys['KeyS']) { moveX -= fwd.x; moveZ -= fwd.z; }
  if(keys['KeyA']) { moveX -= right.x; moveZ -= right.z; }
  if(keys['KeyD']) { moveX += right.x; moveZ += right.z; }
  const len = Math.hypot(moveX,moveZ);
  moving = len > 0 && player.onGround;
  if(len>0){ moveX/=len; moveZ/=len; }
 
  const inWater = getBlock(Math.floor(player.pos.x), Math.floor(player.pos.y+0.4), Math.floor(player.pos.z)) === BLOCK.WATER;
  let speed = keys['ShiftLeft'] ? SPRINT_SPEED : WALK_SPEED;
  if(inWater) speed *= 0.6;
  player.vel.x = moveX*speed;
  player.vel.z = moveZ*speed;
 
  player.vel.y += GRAVITY*(inWater?0.25:1)*dt;
  if(player.vel.y < -30) player.vel.y = -30;
  if(inWater){
    if(player.vel.y < -4) player.vel.y = -4;
    if(keys['Space']) player.vel.y = 4;
  } else if(keys['Space'] && player.onGround){
    player.vel.y = JUMP_SPEED; player.onGround = false;
  }
 
  const disp = new THREE.Vector3(player.vel.x*dt, player.vel.y*dt, player.vel.z*dt);
  player.pos.x += disp.x; if(collides(player.pos)) player.pos.x -= disp.x;
  player.pos.z += disp.z; if(collides(player.pos)) player.pos.z -= disp.z;
  player.pos.y += disp.y;
  if(collides(player.pos)){
    player.pos.y -= disp.y;
    if(disp.y < 0) player.onGround = true;
    player.vel.y = 0;
  } else player.onGround = false;
 
  if(player.pos.y < -10) damagePlayer(20);
}
 
/* ============================ SURVIVAL LOGIC ============================ */
const flashEl = document.getElementById('damageFlash');
function damagePlayer(amount){
  if(!player.alive) return;
  player.health -= amount;
  flashEl.style.opacity = 1; setTimeout(()=>flashEl.style.opacity = 0, 80);
  if(player.health <= 0){
    player.health = 0; player.alive = false;
    document.getElementById('deathScreen').style.display = 'flex';
    if(document.pointerLockElement) document.exitPointerLock();
  }
  updateHudUI();
}
function updateSurvival(dt){
  if(!player.alive) return;
  player.hungerTimer += dt;
  if(player.hungerTimer > 8){ player.hungerTimer = 0; if(player.hunger > 0) player.hunger -= 1; }
  if(player.hunger <= 0){
    player.damageTimer += dt;
    if(player.damageTimer > 3){ player.damageTimer = 0; damagePlayer(1); }
  } else if(player.hunger >= 14){
    player.regenTimer += dt;
    if(player.regenTimer > 4 && player.health < player.maxHealth){ player.regenTimer = 0; player.health = Math.min(player.maxHealth, player.health+1); }
  }
  updateHudUI();
}
 
/* ============================ HUD ============================ */
function heartSVG(state){
  const fill = state===2 ? '#e04141' : '#3a3a3a';
  const half = state===1 ? '<path fill="#e04141" d="M8 14 L2 8.5 C0 6.5 0.5 3 3.5 2.2 C5.5 1.7 7 3 8 4.3 Z"/>' : '';
  return `<svg viewBox="0 0 16 16"><path fill="${fill}" stroke="#000" stroke-width="1" d="M8 14 L2 8.5 C0 6.5 0.5 3 3.5 2.2 C5.5 1.7 7 3 8 4.3 C9 3 10.5 1.7 12.5 2.2 C15.5 3 16 6.5 14 8.5 Z"/>${half}<ellipse cx="4.6" cy="4.8" rx="1.3" ry="0.8" fill="rgba(255,255,255,${state?0.55:0})"/></svg>`;
}
function hungerSVG(state){
  const fill = state===2 ? '#c98a3c' : '#3a3a3a';
  const half = state===1 ? '<path fill="#c98a3c" d="M4 2 C2 2 1 4 1.5 6 C2 9 5 10 5 13 L5 14.5 L8 14.5 L8 3 C6.5 3 5.5 2 4 2Z"/>' : '';
  return `<svg viewBox="0 0 16 16"><path fill="${fill}" stroke="#000" stroke-width="1" d="M4 2 C2 2 1 4 1.5 6 C2 9 5 10 5 13 L5 14.5 L11 14.5 L11 13 C11 10 14 9 14.5 6 C15 4 14 2 12 2 C10.5 2 9.5 3 8 3 C6.5 3 5.5 2 4 2Z"/>${half}</svg>`;
}
let lastHP = -1, lastHunger = -1;
function updateHudUI(){
  if(lastHP === player.health && lastHunger === player.hunger) return;
  lastHP = player.health; lastHunger = player.hunger;
  const hb = document.getElementById('healthBar'), gb = document.getElementById('hungerBar');
  hb.innerHTML = ''; gb.innerHTML = '';
  for(let i=0;i<10;i++){
    const hs = Math.max(0, Math.min(2, player.health - i*2));
    const gs = Math.max(0, Math.min(2, player.hunger - i*2));
    const a = document.createElement('div'); a.className='icon'; a.innerHTML = heartSVG(hs); hb.appendChild(a);
    const b = document.createElement('div'); b.className='icon'; b.innerHTML = hungerSVG(gs); gb.appendChild(b);
  }
}
const nameEl = document.getElementById('blockName');
let nameTimer = null;
function showBlockName(){
  nameEl.textContent = BLOCK_NAMES[inventory[selectedSlot].block] || '';
  nameEl.style.opacity = 1;
  clearTimeout(nameTimer);
  nameTimer = setTimeout(()=>nameEl.style.opacity = 0, 1800);
}
function updateHotbarUI(){
  const hot = document.getElementById('hotbar');
  hot.innerHTML = '';
  inventory.forEach((slot,i) => {
    const div = document.createElement('div');
    div.className = 'slot' + (i===selectedSlot ? ' selected':'');
    div.innerHTML = `<span class="key">${i+1}</span><img src="${ICONS[slot.block]}"><span class="count">${slot.count}</span>`;
    hot.appendChild(div);
  });
}
function selectSlot(i){
  selectedSlot = i; updateHotbarUI(); refreshHand(); showBlockName();
}
 
/* ============================ DAY / NIGHT ============================ */
const C_DAY_TOP = new THREE.Color(0x4f97e6), C_DAY_HOR = new THREE.Color(0xbfe2ff);
const C_NIGHT_TOP = new THREE.Color(0x02030c), C_NIGHT_HOR = new THREE.Color(0x0a0f2c);
const C_DUSK = new THREE.Color(0xff8a4a);
const C_LIGHT_NIGHT = new THREE.Color(0.26,0.32,0.6), C_WHITE = new THREE.Color(1,1,1), C_WARM = new THREE.Color(1,0.8,0.62);
const tmpTop = new THREE.Color(), tmpHor = new THREE.Color();
function smoothstep(a,b,x){ const t = Math.max(0,Math.min(1,(x-a)/(b-a))); return t*t*(3-2*t); }
let underwater = false;
 
function updateDayNight(dt){
  dayTime += dt;
  if(dayTime > DAY_LENGTH) dayTime -= DAY_LENGTH;
  const angle = (dayTime / DAY_LENGTH) * Math.PI * 2;
  const sunH = Math.sin(angle);
  const dayF = smoothstep(-0.12, 0.28, sunH);
  const duskF = Math.max(0, 1 - Math.abs(sunH)/0.3);
 
  tmpTop.copy(C_NIGHT_TOP).lerp(C_DAY_TOP, dayF).lerp(C_DUSK, duskF*0.12);
  tmpHor.copy(C_NIGHT_HOR).lerp(C_DAY_HOR, dayF).lerp(C_DUSK, duskF*0.75);
  skyMat.uniforms.topColor.value.copy(tmpTop);
  skyMat.uniforms.bottomColor.value.copy(tmpHor);
  scene.background.copy(tmpHor);
  if(underwater) scene.fog.color.set(0x1b4aa8); else scene.fog.color.copy(tmpHor);
 
  lightColor.copy(C_LIGHT_NIGHT).lerp(C_WHITE, dayF).lerp(C_WARM, duskF*0.4*dayF + duskF*0.15);
  for(const m of tintables) m.color.copy(lightColor);
 
  const sd = new THREE.Vector3(Math.cos(angle), Math.sin(angle), 0.25).normalize();
  sunMesh.position.copy(camera.position).addScaledVector(sd, 300);
  moonMesh.position.copy(camera.position).addScaledVector(sd, -300);
  sunMesh.lookAt(camera.position); moonMesh.lookAt(camera.position);
  sunMesh.material.opacity = Math.min(1, dayF*3 + 0.3*duskF);
  moonMesh.material.opacity = 1 - dayF;
  starGroup.position.copy(camera.position);
  starGroup.rotation.z = angle;
  starGroup.userData.mat.opacity = Math.max(0, 1 - dayF*1.6);
  skyMesh.position.copy(camera.position);
 
  document.getElementById('timeLabel').textContent = 'Time: ' + (sunH < -0.05 ? 'Night' : (sunH < 0.25 ? 'Dusk/Dawn':'Day'));
}
 
/* ============================ CHUNK STREAMING ============================ */
let unloadCounter = 0;
function updateChunks(maxBuild){
  const [pcx, pcz] = worldToChunk(player.pos.x, player.pos.z);
  const R = RENDER_DISTANCE;
  for(let dx=-R-1; dx<=R+1; dx++) for(let dz=-R-1; dz<=R+1; dz++) getChunk(pcx+dx, pcz+dz, true);
  const need = [];
  for(let dx=-R; dx<=R; dx++) for(let dz=-R; dz<=R; dz++){
    const c = getChunk(pcx+dx, pcz+dz, true);
    if(c.dirty) need.push([dx*dx+dz*dz, pcx+dx, pcz+dz]);
  }
  need.sort((a,b)=>a[0]-b[0]);
  const n = Math.min(maxBuild, need.length);
  for(let i=0;i<n;i++) buildChunkMesh(need[i][1], need[i][2]);
 
  if(++unloadCounter % 30 === 0){
    for(const key in chunks){
      const c = chunks[key];
      if(!c.mesh && !c.waterMesh && !c.plantMesh) continue;
      const [cx,cz] = key.split(',').map(Number);
      if(Math.abs(cx-pcx) > R+1 || Math.abs(cz-pcz) > R+1){ disposeMeshes(c); c.dirty = true; }
    }
  }
}
 
/* ============================ MAIN LOOP ============================ */
let lastTime = performance.now();
let fpsCount = 0, fpsLast = performance.now();
const waterOverlay = document.getElementById('waterOverlay');
 
function animate(){
  requestAnimationFrame(animate);
  const now = performance.now();
  let dt = Math.min((now - lastTime)/1000, 0.05);
  lastTime = now;
 
  moving = false;
  if(player.alive && locked){
    updatePhysics(dt);
    updateSurvival(dt);
    if(mouseHeld){
      breakCooldown -= dt;
      if(breakCooldown <= 0){ breakBlock(); breakCooldown = 0.22; }
    }
  }
 
  camera.position.set(player.pos.x, player.pos.y+PLAYER_HEIGHT*0.9, player.pos.z);
  camera.rotation.y = player.yaw;
  camera.rotation.x = player.pitch;
 
  // underwater look
  const eyeBlock = getBlock(Math.floor(camera.position.x), Math.floor(camera.position.y), Math.floor(camera.position.z));
  underwater = eyeBlock === BLOCK.WATER;
  waterOverlay.style.display = underwater ? 'block' : 'none';
  scene.fog.near = underwater ? 1 : 34;
  scene.fog.far = underwater ? 20 : RENDER_DISTANCE*CHUNK_SIZE - 2;
 
  updateDayNight(dt);
  updateChunks(3);
  updateClouds(dt);
  updateParticles(dt);
  updateHand(dt, moving);
 
  waterTex.offset.x = (waterTex.offset.x + dt*0.04) % 1;
  waterTex.offset.y = (waterTex.offset.y + dt*0.025) % 1;
 
  // highlight targeted block
  if(locked && player.alive){
    const hit = raycastVoxel(eyePos(), getLookDir(), 6);
    if(hit){ highlight.visible = true; highlight.position.set(hit.x+0.5, hit.y+0.5, hit.z+0.5); }
    else highlight.visible = false;
  } else highlight.visible = false;
 
  document.getElementById('posLabel').textContent = 'Pos: ' + player.pos.x.toFixed(1) + ', ' + player.pos.y.toFixed(1) + ', ' + player.pos.z.toFixed(1);
  fpsCount++;
  if(now - fpsLast > 500){
    document.getElementById('fpsCounter').textContent = 'FPS: ' + Math.round(fpsCount*1000/(now-fpsLast));
    fpsCount = 0; fpsLast = now;
  }
 
  renderer.clear();
  renderer.render(scene, camera);
  renderer.clearDepth();
  renderer.render(handScene, handCam);
}
 
/* ============================ INIT ============================ */
findSpawn();
updateHudUI();
updateHotbarUI();
updateChunks(9999);
camera.position.set(player.pos.x, player.pos.y+PLAYER_HEIGHT*0.9, player.pos.z);
animate();
 
})();
</script>
